@layout('layouts/main')



<div class="container py-4">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-800 tracking-tight mb-0">Menus disponibles</h2>
    {{-- <div class="text-muted small d-none d-md-block">Yaoundé, Cameroun</div> --}}
  </div>

  <div class="row g-2 mb-4">
    <div class="col-12">
      <div class="input-group shadow-sm rounded-pill overflow-hidden bg-white border px-2 py-1">
        <span class="input-group-text bg-white border-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
          </svg>
        </span>
        <input type="text" class="form-control border-0 shadow-none py-2" placeholder="Quel plat recherchez-vous ?">
      </div>
    </div>
  </div>

  <div class="row g-3">
    @each(menu in menus)
   
    <div class="col-6 col-md-4 col-lg-3 mb-4">
      <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden menu-card-modern position-relative">
        <a href="{{route('menus.show', {id: menu.id})}}"></a>
        <div class="position-relative overflow-hidden" style="height: 160px;">
          <img src="{{ menu.image ? 'storage/' + menu.image : '//images/food-plate.avif' }}" 
               class="card-img-top w-100 h-100 object-fit-cover transition-zoom" 
               alt="{{ menu.name }}">
          
          {{-- <span class="position-absolute top-0 start-0 m-2 badge bg-warning text-dark fw-bold rounded-pill shadow-sm px-2 py-1" style="font-size: 0.65rem;">
            <i class="bi bi-star-fill me-1"></i>Populaire
          </span> --}}

          {{-- <button class="btn btn-fav-glass rounded-circle position-absolute top-0 end-0 m-2 shadow-sm border-0">
            <i class="bi bi-heart text-white"></i>
          </button> --}}
        </div>
        </a> 
        <div class="card-body p-3 d-flex flex-column">
          <div class="mb-2">
            <h6 class="fw-800 mb-0 text-dark text-truncate h6">{{ menu.name }}</h6>
            {{-- <div class="d-flex align-items-center gap-1 mt-1">
              <i class="bi bi-shop text-muted" style="font-size: 0.75rem;"></i>
              <p class="small text-muted mb-0 text-truncate fw-medium">{{menu.restaurant}}</p>
            </div> --}}
          </div>

          <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
            <div class="d-flex flex-column">
              <span class="text-success fw-bold fs-5">{{ menu.price }} <small>F</small></span>
            </div>
            
            <form action="{{ route('commandes.store') }}" method="POST">
              {{ csrfField() }}
              
              {{-- 1. On envoie l'ID du menu ici 👈 --}}
              <input type="hidden" name="menuId" value="{{ menu.id }}">

              <button type="submit" class="btn btn-add-cart rounded-pill shadow-sm border-0">
                <i class="bi bi-plus-lg"></i>
              </button>
            </form>
          </div>
        </div>
      </div> 
    </div>
   
@endeach

<style>
  .fw-800 { font-weight: 800; }
  
  /* Animation de la carte */
  .menu-card-modern {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background: #fff;
  }
  .menu-card-modern:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.12) !important;
  }

  /* Zoom sur l'image au survol */
  .transition-zoom {
    transition: transform 0.5s ease;
  }
  .menu-card-modern:hover .transition-zoom {
    transform: scale(1.1);
  }

  /* Bouton Favoris Style "Glass" */
  .btn-fav-glass {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .btn-fav-glass:hover {
    background: #E31E24;
    transform: scale(1.1);
  }

  /* Bouton Ajouter au panier */
  .btn-add-cart {
    background-color: #E31E24;
    color: white;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-add-cart:hover {
    background-color: #1e1e1e;
    transform: rotate(90deg);
  }

  /* Ajustement texte */
  .text-success { color: #2ecc71 !important; }
</style>
  </div>

</div>

<style>
  .fw-800 { font-weight: 800; }
  .menu-card { transition: transform 0.2s ease; cursor: pointer; }
  .menu-card:hover { transform: translateY(-4px); }
  .btn-white { background: white; border: none; }
  
  /* Dropdown styling */
  .dropdown-item:active { background-color: #E31E24; }
  .dropdown-menu { min-width: 200px; }
</style>
