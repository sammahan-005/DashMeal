@layout('layouts/main')


<div class="container py-5 min-vh-100">
  
  <div class="row align-items-center mb-5">
    <div class="col-md-8">
      <h1 class="fw-800 h2 mb-1">Historique des commandes</h1>
      <p class="text-muted">Retrouvez ici tous vos festins passés et présents sur DashMeal.</p>
    </div>
    <div class="col-md-4 text-md-end">
      <div class="dropdown">
        <button class="btn btn-white border rounded-pill px-4 fw-bold dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
          Filtrer par statut
        </button>
        <ul class="dropdown-menu shadow border-0 rounded-3">
          <li><a class="dropdown-item" href="?validated=true && validated=false">Toutes</a></li>
          <li><a class="dropdown-item" href="?validated=true">Livrées</a></li>
          <li><a class="dropdown-item" href="?validated=false">Annulées</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="row g-4">
    @each(commande in commandes)
      <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden order-history-card">
          <div class="card-body p-0">
            <div class="row g-0">
              
              <div class="col-auto d-flex align-items-stretch">
                <div class="status-indicator {{ 
                  commande.validated == true ? 'bg-success' : 
                  (commande.validated == false ? 'bg-danger' : 'bg-warning') 
                }}" style="width: 6px;"></div>
              </div>

              <div class="col p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start mb-3">
                  <div class="d-flex align-items-center gap-3 mb-2 mb-md-0">
                    <div class="bg-light rounded-3 p-2 text-center" style="width: 50px;">
                      <i class="bi bi-bag-check text-secondary fs-4"></i>
                    </div>
                    <div>
                      <h5 class="fw-bold mb-0">#</h5>
                      <span class="small text-muted">Commandé le {{ commande.updatedAt.toFormat('dd LLL yyyy à HH:mm') }}</span>
                    </div>
                  </div>
                  
                  <div class="text-md-end">
                    <span class="fw-800 h5 mb-0 d-block">{{ commande.totalPrice }} F</span>
                    <span class="badge rounded-pill {{ 
                      commande.validated== true ? 'bg-success-subtle text-success' : 
                      (commande.validated == false ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning') 
                    }} px-3 py-2 small fw-bold">
                      @if(commande.validated == true)
                        Livrée
                      @elseif(commande.validated == false)
                        Annulée
                      @else
                        En cours
                      @end
                    </span>
                  </div>
                </div>

                <div class="bg-light rounded-3 p-3 mb-3">
                  <p class="x-small fw-bold text-uppercase text-muted mb-2">Détails</p>
                  <div class="d-flex flex-wrap gap-2">
                    @each(item in commande.menus)
                      <span class="badge bg-white text-dark border fw-normal py-2 px-3 rounded-pill shadow-sm">
                        {{ item.name }}
                      </span>
                    @end
                  </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                 
                  <a href="{{ route('commandes.show', { id: commande.id }) }}" class="btn btn-sm btn-light rounded-pill px-4 fw-bold border" >
                    Détails facture
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    @else
      <div class="col-12 text-center py-5">
        <div class="bg-white rounded-5 p-5 shadow-sm d-inline-block">
          <i class="bi bi-journal-x display-1 text-light"></i>
          <h3 class="fw-bold mt-4">Aucun historique</h3>
          <p class="text-muted mb-0">Vous n'avez pas encore passé de commande.</p>
        </div>
      </div>
    @end
  </div>
</div>

<style>
  .fw-800 { font-weight: 800; }
  .text-dash-red { color: #E31E24; }
  .x-small { font-size: 0.7rem; }
  
  .order-history-card {
    transition: all 0.2s ease;
    border: 1px solid rgba(0,0,0,0.05) !important;
  }
  
  .order-history-card:hover {
    transform: translateX(5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
  }

  .bg-success-subtle { background-color: #d1e7dd; }
  .bg-danger-subtle { background-color: #f8d7da; }
  .bg-warning-subtle { background-color: #fff3cd; }

  /* Pour mobile : on empile les infos */
  @media (max-width: 576px) {
    .order-history-card .p-4 { padding: 1.5rem !important; }
  }
</style>
@end