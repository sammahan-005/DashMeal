@layout('layouts/main')


<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      
      {{-- Retour et Titre --}}
      <div class="mb-4">
        <a href="javascript:history.back()" class="text-muted text-decoration-none small mb-2 d-block">
          <i class="bi bi-arrow-left"></i> Retour à ma carte
        </a>
        <h2 class="fw-bold text-dark">Ajouter un nouveau plat</h2>
        <p class="text-muted">Remplissez les informations pour publier ce menu sur DashMeal.</p>
      </div>

      {{-- Carte du Formulaire --}}
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <form action="{{ route('menus.store') }}" method="POST" enctype="multipart/form-data">
          {{ csrfField() }}

          {{-- Nom du plat --}}
          <div class="mb-3">
            <label for="name" class="form-label fw-bold">Nom du menu</label>
            <input type="text" 
                   name="name" 
                   id="name" 
                   class="form-control rounded-3 {{ flashMessages.has('errors.name') ? 'is-invalid' : '' }}" 
                   placeholder="Ex: Poulet DG, Pizza Margherita..."
                   value="{{ flashMessages.get('name') || '' }}" 
                   required>
            @if(flashMessages.has('errors.name'))
              <div class="invalid-feedback">{{ flashMessages.get('errors.name') }}</div>
            @endif
          </div>

          {{-- Prix et Catégorie --}}
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="price" class="form-label fw-bold">Prix (FCFA)</label>
              <div class="input-group">
                <input type="number" 
                       name="price" 
                       id="price" 
                       class="form-control rounded-start-3 {{ flashMessages.has('errors.price') ? 'is-invalid' : '' }}" 
                       placeholder="0"
                       value="{{ flashMessages.get('price') || '' }}"
                       required>
                <span class="input-group-text bg-light rounded-end-3 border-start-0">F</span>
              </div>
            </div>
            
            <div class="col-md-6 mb-3">
              <label for="category" class="form-label fw-bold">Catégorie</label>
              <select name="category" id="category" class="form-select rounded-3">
                <option value="entree">Entrée</option>
                <option value="plat" selected>Plat de résistance</option>
                <option value="dessert">Dessert</option>
                <option value="boisson">Boisson</option>
              </select>
            </div>
          </div>

          {{-- Description --}}
          <div class="mb-3">
            <label for="description" class="form-label fw-bold">Description (Ingrédients, portion...)</label>
            <textarea name="description" 
                      id="description" 
                      rows="3" 
                      class="form-control rounded-3" 
                      placeholder="Décrivez brièvement votre plat...">{{ flashMessages.get('description') || '' }}</textarea>
          </div>

          {{-- Image du plat --}}
          <div class="mb-4">
            <label for="image" class="form-label fw-bold">Photo du plat</label>
            <div class="p-3 border-dashed rounded-3 bg-light text-center position-relative">
              <input type="file" 
                     name="image" 
                     id="image" 
                     class="form-control position-absolute opacity-0 top-0 start-0 w-100 h-100 cursor-pointer" 
                     accept="image/*">
              <div class="py-2">
                <i class="bi bi-cloud-arrow-up fs-2 text-muted"></i>
                <p class="mb-0 small text-muted">Cliquez pour ajouter une image (PNG, JPG)</p>
              </div>
            </div>
          </div>

          {{-- Boutons d'action --}}
          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-danger py-2 fw-bold rounded-pill shadow-sm bg-dash-red">
              Publier le menu
            </button>
            <a href="javascript:history.back()" class="btn btn-light py-2 fw-bold rounded-pill text-muted">
              Annuler
            </a>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

<style>
  .border-dashed { border: 2px dashed #dee2e6; }
  .cursor-pointer { cursor: pointer; }
  .bg-dash-red { background-color: #E31E24; border: none; }
  .bg-dash-red:hover { background-color: #b3171b; }
  .form-control:focus, .form-select:focus { border-color: #E31E24; box-shadow: 0 0 0 0.25rem rgba(227, 30, 36, 0.1); }
</style>
