          <span class="badge border text-muted rounded-pill px-3">Pimenté</span>
        </div> --}}
      </div>
    </div>
  </div>
</div>

<style>
  .fw-800 { font-weight: 800; }
  .text-dash-red { color: #E31E24; }
  .bg-dash-red { background-color: #E31E24; }
  .bg-dash-red-subtle { background-color: #ffebee; }
  .btn-dash-red { background-color: #E31E24; border: none; }
  .btn-dash-red:hover { background-color: #c1181d; transform: translateY(-2px); }
  
  .hov-scale { transition: all 0.2s; }
  .hov-scale:active { transform: scale(0.98); }

  .object-fit-cover { object-fit: cover; }
</style>

<script>
  function updateQty(delta) {
    const input = document.getElementById('qty');
    let val = parseInt(input.value) + delta;
    if (val < 1) val = 1;
    input.value = val;
  }
</script>

