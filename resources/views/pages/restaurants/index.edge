@layout('layouts/main')

<div class="restaurant-profile bg-light min-vh-100">
  
 
    <div class="container py-4">
      <div class="row align-items-center g-4">
        <div class="col-12 col-md-auto text-center">
          <div class="mx-auto rounded-4 shadow-sm border overflow-hidden" style="width: 120px; height: 120px;">
            <img src="{{ restaurant.logoUrl || '/logo.jpeg' }}" class="w-100 h-100 object-fit-cover" alt="Logo">
          </div>
        </div>
        
        <div class="col-12 col-md text-center text-md-start">
          <div class="d-flex flex-column flex-md-row align-items-center gap-2 mb-2">
            <h1 class="fw-800 h2 mb-0">{{ restaurant.name }}</h1>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Ouvert</span>
          </div>
          <p class="text-muted mb-3 fs-6 max-w-md">{{ restaurant.description }}</p>
          <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-3 small fw-medium">
            <span class="text-secondary"><i class="bi bi-geo-alt-fill text-dash-red me-1"></i>{{ restaurant.address }}</span>
            <span class="text-secondary"><i class="bi bi-telephone-fill text-dash-red me-1"></i>{{ restaurant.phone_number }}</span>
            {{-- <span class="text-dark"><i class="bi bi-star-fill text-warning me-1"></i>4.8 (120 avis)</span> --}}
          </div>
        </div>

        <div class="col-12 col-md-auto text-center">
          <button 
            class="btn btn-outline-dark rounded-pill px-4 fw-bold transition-all" 
            id="shareBtn"
            onclick="copyRestaurantLink()">
            <i class="bi bi-share me-2" id="shareIcon"></i>
            <span id="shareText">Partager</span>
          </button>
        </div>

      <script>
        function copyRestaurantLink() {
          const btn = document.getElementById('shareBtn');
          const text = document.getElementById('shareText');
          const icon = document.getElementById('shareIcon');
          const url = window.location.href;

          // Fonction pour changer l'UI après succès
          const showSuccess = () => {
            text.innerText = "Lien copié !";
            btn.classList.replace('btn-outline-dark', 'btn-success');
            icon.classList.replace('bi-share', 'bi-check2');

            setTimeout(() => {
              text.innerText = "Partager";
              btn.classList.replace('btn-success', 'btn-outline-dark');
              icon.classList.replace('bi-check2', 'bi-share');
            }, 2000);
          };

          // 1. Tentative avec l'API moderne
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(url).then(showSuccess).catch(() => fallbackCopy(url, showSuccess));
          } else {
            // 2. Méthode de secours pour Mobile / Non-HTTPS
            fallbackCopy(url, showSuccess);
          }
        }

        function fallbackCopy(textToCopy, callback) {
          // Création d'un élément invisible pour simuler une sélection de texte
          const textArea = document.createElement("textarea");
          textArea.value = textToCopy;
          textArea.style.position = "fixed"; // Évite le scroll lors de l'ajout
          textArea.style.left = "-9999px";
          textArea.style.top = "0";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();

          try {
            const successful = document.execCommand('copy');
            if (successful) callback();
          } catch (err) {
            console.error('Impossible de copier', err);
          }

          document.body.removeChild(textArea);
        }
      </script>
      </div>
    </div>
  

  

  <main class="container py-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 px-2 gap-3">
    <h3 class="fw-bold mb-0">La Carte</h3>
    
    <div class="d-flex gap-2">
      <a href="{{ route('restaurants.pending', { id: restaurant.$attributes.id }) }}"
         class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-receipt"></i>
        <span>Commandes reçues</span>
      </a>

      <a href="{{ route('menus.create') }}" 
         class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Nouveau Menu</span>
      </a>
    </div>
  </div>
  
  <div class="row g-4">
    @each(menu in menus)
      <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 menu-card">
          <div class="d-flex flex-row align-items-stretch h-100">
            
            <div class="flex-shrink-0" style="width: 140px; min-height: 140px;">
              <img src="{{ menu.image ? 'storage/' + menu.image : '/food-plate.avif' }}" 
                   class="w-100 h-100 object-fit-cover" 
                   alt="{{ menu.name }}">
            </div>

            <div class="card-body d-flex flex-column p-3">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <h5 class="fw-bold mb-0 text-dark">{{ menu.name }}</h5>
                <span class="fw-bold text-success">{{ menu.price }} <small>F</small></span>
              </div>
              
              <p class="small text-muted mb-3 flex-grow-1 text-limit-2">
                {{ menu.description || 'Une spécialité savoureuse préparée avec passion par notre chef.' }}
              </p>

              <div class="d-flex justify-content-between align-items-center mt-auto">
                {{-- Badge de catégorie si disponible --}}
                <span class="badge bg-light text-secondary fw-normal rounded-pill px-2 py-1 x-small">
                  {{ menu.category || 'Classique' }}
                </span>
                
                
              </div>
            </div>

          </div>
        </div>
      </div>
    @else
    
      <div class="col-12 text-center py-5">
        <div class="bg-white rounded-4 p-5 shadow-sm border border-dashed">
          <i class="bi bi-basket3 display-4 text-light"></i>
          <p class="text-muted mt-3 mb-3">Aucun menu disponible pour le moment.</p>
          
          <a href="{{ route('menus.create', { id: restaurant.id }) }}" class="btn btn-outline-dark btn-sm rounded-pill px-4">
            Créer le premier menu
          </a>
        </div>
      </div>
    @end
  </div>
</main>
</div>

<style>
  .fw-800 { font-weight: 800; }
  .text-dash-red { color: #E31E24; }
  .bg-dash-red { background-color: #E31E24; }
  .object-fit-cover { object-fit: cover; }
  
  /* Navigation Catégories */
  .nav-cat {
    text-decoration: none;
    font-weight: 700;
    color: #6c757d;
    white-space: nowrap;
    transition: all 0.2s;
    border-bottom: 3px solid transparent;
    padding-bottom: 4px;
  }
  .nav-cat:hover, .nav-cat.active {
    color: #E31E24;
    border-bottom-color: #E31E24;
  }

  /* Cartes Menus */
  .menu-card {
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .menu-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important;
  }

  /* Limiter la description à 2 lignes */
  .text-limit-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pour cacher la scrollbar des catégories */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  @media (max-width: 576px) {
    .menu-card .flex-shrink-0 { width: 110px !important; }
    .h2 { font-size: 1.5rem; }
  }
</style>
@end